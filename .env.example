# Local API configuration. Production values belong in the API host's secret manager.
PORT=4002
DATABASE_URL=mysql://ojix:ojix_local_only@127.0.0.1:3308/ojix_property_mysql
DATABASE_SSL=false
# Local-only CA path; Cloud SQL deployments set DATABASE_SSL=true and mount a trusted CA.
DATABASE_SSL_CA=
DB_POOL_LIMIT=10
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8080
TRUST_PROXY_HOPS=1
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
# Sandbox document storage: local (default), supabase, or gcs. Cloud buckets must be private.
DOCUMENT_STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-documents
# Signed document links are capped at 15 minutes by the API.
SIGNED_URL_TTL_SECONDS=300
# Leave unset for local development only. In cloud, set the Firebase project ID to require verified ID tokens.
FIREBASE_PROJECT_ID=
# Optional bootstrap identity. On first API start the account is created once;
# later restarts preserve the stored password. Use a 12+ character password with
# uppercase, lowercase, number and symbol. Never put these in VITE_* variables.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Legacy allowlist supported during migration. Prefer SUPER_ADMIN_EMAIL above.
SUPER_ADMIN_EMAILS=
# Use GCS only after a private bucket and least-privilege runtime IAM exist.
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
# API PDF reports use system Chromium (Alpine image defaults are auto-detected).
CHROMIUM_EXECUTABLE_PATH=
# Login/registration OTP email delivery through SMTP. For Gmail, use smtp.gmail.com
# with port 465 + SMTP_SECURE=true or port 587 + SMTP_SECURE=false, and an App Password.
# SMTP_FROM is optional; when blank, SMTP_USER is used as the sender.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Inbox that receives OTPs for demo accounts with the shared demo address.
DEMO_OTP_EMAIL=
# Optional SMS fallback. Only verified/configured numbers may receive login codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
DEMO_OTP_PHONE=
# Local demo convenience only. Never enable in production.
DEV_AUTO_FILL_MOBILE_OTP=false
# Local demo password inputs are stored as password hashes in account_password_overrides.
# Set each value in your ignored .env file; do not add plaintext passwords to source control.
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_OWNER_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_LAWYER_PASSWORD=
DEMO_ANALYST_PASSWORD=
DEMO_OPERATIONS_PASSWORD=
DEMO_CONSULTANT_PASSWORD=
DEMO_SUPPORT_PASSWORD=
DEMO_DATA_STEWARD_PASSWORD=
DEMO_VIEWER_PASSWORD=
# Local Tesseract OCR worker settings.

# Karnataka RTC retrieval. Keep disabled until an officially authorized API is supplied.
# Supported modes: disabled | api. The fixture mode is accepted only in NODE_ENV=test.
RTC_PROVIDER_MODE=disabled
RTC_SOURCE_NAME=Karnataka Bhoomi
RTC_SOURCE_URL=https://landrecords.karnataka.gov.in/Service2/
RTC_API_BASE_URL=
RTC_API_TOKEN=
RTC_REQUEST_TIMEOUT_MS=10000
OCR_WORKER_TOKEN=
OCR_RETRY_DELAY_SECONDS=30
OCR_LANGUAGES=kan+eng
OCR_MAX_PAGES=5
OCR_TIMEOUT_MS=120000
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
