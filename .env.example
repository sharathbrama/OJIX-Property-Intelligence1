# API
PORT=4000
DATABASE_URL=mysql://ojix:ojix_local_only@127.0.0.1:3306/ojix_property_mysql
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
# Leave unset for local development only. In cloud, set the Firebase project ID to require verified ID tokens.
FIREBASE_PROJECT_ID=
# Comma-separated email allowlist for production platform super-admin access.
SUPER_ADMIN_EMAILS=
# Cloud Storage integration is not enabled until bucket IAM and credentials are configured.
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
# Real login/registration OTP email delivery (Resend).
RESEND_API_KEY=
OTP_FROM_EMAIL=OJIX Security <security@your-verified-domain.com>
# Inbox that receives OTPs when signing in as a local demo account (@ojix.local).
DEMO_OTP_EMAIL=
# Twilio SMS OTP delivery. Set either TWILIO_FROM_NUMBER or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Inbox phone (E.164 format, e.g. +14155552671) for local demo-account SMS OTPs.
DEMO_OTP_PHONE=
# Vertex AI / Document AI integrations are future adapters; do not paste service-account keys here.

# Karnataka RTC retrieval. Keep disabled until an officially authorized API is supplied.
# Supported modes: disabled | api. The fixture mode is accepted only in NODE_ENV=test.
RTC_PROVIDER_MODE=disabled
RTC_SOURCE_NAME=Karnataka Bhoomi
RTC_SOURCE_URL=https://landrecords.karnataka.gov.in/Service2/
RTC_API_BASE_URL=
RTC_API_TOKEN=
RTC_REQUEST_TIMEOUT_MS=10000
